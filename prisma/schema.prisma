  id                              String                  @id @default(uuid())
  name                            String
  email                           String                  @unique
  passwordHash                    String
  role                            UserRole                @default(CLIENTE)
  roles                           UserRole[]              @default([])
  createdAt                       DateTime                @default(now())
  updatedAt                       DateTime                @updatedAt
  isActive                        Boolean                 @default(true)
