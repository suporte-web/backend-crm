  nome              String
  email             String            @unique
  status            StatusInformativo @default(ATIVO)
  origem            String            @default("SITE_PIZZATTOLOG")
  aceitePrivacidade Boolean           @default(false)
  criadoEm          DateTime          @default(now())
  atualizadoEm      DateTime          @updatedAt
}

// ----- Lead.prisma -----
model Lead {
  siteRequest SolicitacaoSite? @relation("SolicitacaoSiteLead")
  cadastroId    String? @unique(map: "Lead_registrationId_key") @map("registrationId")
  cadastro      Client? @relation("CadastroLead", fields: [cadastroId], references: [id], onDelete: SetNull, map: "Lead_registrationId_fkey")
  id                String                @id @default(uuid())
  name              String
  email             String?
  phone             String?
  company           String?
  source            String                @default("manual")
  status            String                @default("new")
  notes             String?
  normalizedEmail   String?
  normalizedPhone   String?
  channel           String?
  sourcePhone       String?
  externalMessageId String?
  externalContactId String?
  metadata          Json?
  rawPayload        Json?
  lastInteractionAt DateTime?
  createdById       String?
  updatedById       String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  prospectedById    String?
  prospectedByName  String?
  convertedProspectId String?
  convertedProspect Prospect? @relation("LeadConvertedProspect", fields: [convertedProspectId], references: [id], onDelete: SetNull)
  originatedProspects Prospect[] @relation("ProspectSourceLead")
  convertedClients Client[] @relation("ClientSourceLead")
  chats             Chat[]
  createdBy         User?                 @relation("LeadCreatedBy", fields: [createdById], references: [id])
  updatedBy         User?                 @relation("LeadUpdatedBy", fields: [updatedById], references: [id])
  importRows        LeadImportRowResult[]
  timeline          LeadTimelineEvent[]
  tickets           Ticket[]
  observations      LeadObservacao[]
  anexos            LeadAnexo[]
  deletionRequests  LeadDeletionRequest[]

  convertidoParaCliente Boolean @default(false)

  @@index([normalizedEmail])
  @@index([normalizedPhone])
  @@index([source, createdAt])
  @@index([status, createdAt])
  @@index([prospectedById, createdAt])
  @@index([convertedProspectId])
}

// ----- LeadAnexo.prisma -----
model LeadAnexo {
  id String @id @default(uuid())
  leadId String
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  nome String
  arquivo String
  tipo String
  tamanho Int
  comentario String?
  criadoEm DateTime @default(now())
  usuarioId String?
