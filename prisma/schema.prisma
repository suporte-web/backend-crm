  @@index([prospectId])
  @@index([quoteId])
  @@index([leadId])
  @@index([opportunityId])
  @@index([assignedToId, status])
  @@index([type, status])
  @@index([requiresActionRole, status])
  @@index([internalOnly, status])
  @@index([status, createdAt])
  @@index([lastInteractionAt])
  @@index([origem, createdAt])
  @@index([protocolo])
}

