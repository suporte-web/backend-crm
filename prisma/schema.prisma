// ----- ArtigoCentralAjuda.prisma -----
model HelpCenterArticle {
  id          String   @id @default(uuid())
  title       String
  questions   String[]
  answer      String
  category    String
  tags        String[]
  active      Boolean  @default(true)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation("HelpCenterArticleCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?    @relation("HelpCenterArticleUpdatedBy", fields: [updatedById], references: [id])

  @@index([active, category])
  @@index([createdAt])
}

// ----- AtendimentoSac.prisma -----
enum StatusAtendimentoSac {
  NOVO
  ATRIBUIDO
  EM_ATENDIMENTO
  CLASSIFICADO
  AGUARDANDO_ACAO
  EM_TRATATIVA
  AGUARDANDO_AVALIACAO
  CONCLUIDO
  REABERTO
}
enum TipoTarefaSac {
  TRIAGEM
  ATENDIMENTO
  CLASSIFICACAO
  ACAO_CORRETIVA
  AVALIACAO_SOLUCAO
  REGISTRO_RNC
  CONCLUSAO
}
enum StatusTarefaSac {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}
model AtendimentoSac {
  visita VisitaCliente?
  id String @id @default(uuid())
  numero Int @unique @default(autoincrement())
  protocolo String? @unique
  ticketOrigemId String @unique
  ticketOrigem Ticket @relation(fields: [ticketOrigemId], references: [id], onDelete: Restrict)
  relatoOriginal Json
  tipo String
  nome String
  email String?
  telefone String?
  empresa String?
  cidade String?
  estado String?
  status StatusAtendimentoSac @default(NOVO)
  atendenteId String?
  atendente User? @relation("SacAtendente", fields: [atendenteId], references: [id])
  responsavelAcaoId String?
  responsavelAcao User? @relation("SacAcao", fields: [responsavelAcaoId], references: [id])
  area String?
  tipoReclamacao String?
  documento String?
  motivo String?
  observacoesClassificacao String?
  planoAcao Json?
  rnc Json?
  prazo DateTime?
  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  concluidoEm DateTime?
  concluidoPorId String?
  concluidoPor User? @relation("SacConclusao", fields: [concluidoPorId], references: [id])
  historico AtendimentoSacHistorico[]
  tarefas AtendimentoSacTarefa[]
  anexos AtendimentoSacAnexo[]
  @@index([status, criadoEm])
  @@index([atendenteId, status])
  @@index([responsavelAcaoId, status])
  @@index([area])
}
model AtendimentoSacHistorico {
  id String @id @default(uuid())
  atendimentoId String
  atendimento AtendimentoSac @relation(fields: [atendimentoId], references: [id], onDelete: Restrict)
  tipo String
  descricao String
  usuarioId String?
  usuario User? @relation("SacHistoricoUsuario", fields: [usuarioId], references: [id])
  criadoEm DateTime @default(now())
  statusAnterior StatusAtendimentoSac?
  statusNovo StatusAtendimentoSac?
  tarefaId String?
  tarefa AtendimentoSacTarefa? @relation(fields: [tarefaId], references: [id])
  dados Json?
  @@index([atendimentoId, criadoEm])
}
model AtendimentoSacTarefa {
  id String @id @default(uuid())
  atendimentoId String
  atendimento AtendimentoSac @relation(fields: [atendimentoId], references: [id], onDelete: Restrict)
  titulo String
  tipo TipoTarefaSac
  responsavelId String?
  responsavel User? @relation("SacTarefaResponsavel", fields: [responsavelId], references: [id])
  perfilResponsavel UserRole?
  criadorId String?
  criador User? @relation("SacTarefaCriador", fields: [criadorId], references: [id])
  criadoEm DateTime @default(now())
  prazo DateTime?
  iniciadoEm DateTime?
  concluidoEm DateTime?
  status StatusTarefaSac @default(PENDENTE)
  observacao String?
  historico AtendimentoSacHistorico[]
  anexos AtendimentoSacAnexo[]
  @@index([responsavelId, status])
  @@index([atendimentoId, tipo])
}
model AtendimentoSacAnexo {
  id String @id @default(uuid())
  atendimentoId String
  atendimento AtendimentoSac @relation(fields: [atendimentoId], references: [id], onDelete: Restrict)
  nome String
  arquivo String
  tipo String
  tamanho Int
  comentario String?
  etapa String
  criadoEm DateTime @default(now())
  usuarioId String?
  usuario User? @relation("SacAnexoUsuario", fields: [usuarioId], references: [id])
  tarefaId String?
  tarefa AtendimentoSacTarefa? @relation(fields: [tarefaId], references: [id])
  @@index([atendimentoId, etapa])
}

// ----- Chat.prisma -----
model Chat {
  id           String            @id @default(uuid())
  entityType   ChatEntityType
  entityId     String
  title        String?
  leadId       String?
  clientId     String?
  quoteId      String?
  propostaId   String?
  ticketId     String?
  createdById  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  client       Client?           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lead         Lead?             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  proposta     Proposta?         @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  quote        Quote?            @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  ticket       Ticket?           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  messages     ChatMessage[]
  participants ChatParticipant[]

  @@unique([entityType, entityId])
  @@index([clientId])
  @@index([leadId])
  @@index([quoteId])
  @@index([propostaId])
  @@index([ticketId])
  @@index([entityType, createdAt])
}

// ----- Cliente.prisma -----
model Client {
  empresaConsultoraId String?
  empresaConsultora EmpresaConsultora? @relation(fields: [empresaConsultoraId], references: [id], onDelete: Restrict)
  solicitacoesSite SolicitacaoSite[] @relation("SolicitacaoSiteClient")
  modalidadeCadastro     ModalidadeCadastro @default(CLIENTE) @map("registrationType")
  leadCadastro     Lead? @relation("CadastroLead")
  id                   String    @id @default(uuid())
  document             String?   @unique
  phone                String?
  companyName          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  internalOwnerId      String?
  responsavelId        String?
  responsavel          User? @relation("ResponsavelComercialCadastro", fields: [responsavelId], references: [id], onDelete: SetNull)
  notes                String?
  segment              String?
  status               String?
  legalName            String?
  tradeName            String?
  cnae                 String?
  stateRegistration    String?
  businessActivity     String?
  taxRegime            String?
  address              String?
  city                 String?
  bankDetails          String?
  modality             String?
  registrationDate     DateTime?
  paymentMethod        String?
  paymentTerm          String?
  contractValidity     String?
  priceAdjustment      String?
  invoiceContactName   String?
  invoiceContactEmail  String?
  invoiceContactPhone  String?
  commercialTermsNotes String?
  userId               String?   @unique
  prospectedById       String?
  prospectedByName     String?
  sourceLeadId         String?
  sourceLead           Lead? @relation("ClientSourceLead", fields: [sourceLeadId], references: [id], onDelete: SetNull)
  sourceProspectId     String?
  sourceProspect       Prospect? @relation("ClientSourceProspect", fields: [sourceProspectId], references: [id], onDelete: SetNull)

  chats            Chat[]
  user             User?                   @relation("ClientLoginUser", fields: [userId], references: [id])
  contacts         ClientContact[]
  deletionRequests ClientDeletionRequest[]
  documents        ClientDocument[]
  opportunities    Opportunity[]
  propostas        Proposta[]
  quotes           Quote[]
  tickets          Ticket[]
  timelineEvents   TimelineEvent[]
  trackings        Tracking[]

  @@index([internalOwnerId])
  @@index([responsavelId, createdAt])
  @@index([empresaConsultoraId, createdAt])
  @@index([prospectedById, createdAt])
  @@index([sourceLeadId])
  @@index([sourceProspectId])
  @@index([modalidadeCadastro, createdAt], map: "Client_registrationType_createdAt_idx")
}

enum ModalidadeCadastro {
  CLIENTE @map("CLIENT")
  LEAD

  @@map("RegistrationType")
}

model ClientDocument {
  id           String   @id @default(uuid())
  clientId     String
  fileName     String
  originalName String
  mimeType     String?
  size         Int?
  url          String
  description  String?
  uploadedById String?
  createdAt    DateTime @default(now())
  category     String?
  updatedAt    DateTime @default(now())
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])

  @@index([clientId])
  @@index([uploadedById])
  @@index([clientId, createdAt])
}

model ClientContact {
  id        String   @id @default(uuid())
  clientId  String
  name      String?
  role      String?
  email     String?
  phone     String?
  notes     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

// ----- ConteudoPortal.prisma -----
model PortalContent {
  id            String      @id @default(uuid())
  title         String
  summary       String
  body          String
  type          ContentType
  coverImageUrl String?
  videoUrl      String?
  isPublished   Boolean     @default(false)
  publishedAt   DateTime?
  authorId      String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  campaignName  String?
  ctaLabel      String?
  ctaUrl        String?
  highlight     Boolean     @default(false)
  author        User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([type, isPublished, publishedAt])
  @@index([authorId, createdAt])
}

// ----- ConviteFornecedor.prisma -----
model SupplierInvite {
  id          String               @id @default(uuid())
  companyName String
  contactName String?
  email       String
  phone       String?
  token       String               @unique
  status      SupplierInviteStatus @default(PENDING)
  notes       String?
  invitedById String?
  acceptedAt  DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  invitedBy   User?                @relation("SupplierInviteAuthor", fields: [invitedById], references: [id])

  @@index([email, createdAt])
  @@index([status, createdAt])
