// ----- SolicitacaoSite.prisma -----
model SolicitacaoSite {
  id String @id @default(uuid())

  // Controle da solicitação
  tipo         String
  departamento String?
  status       String  @default("NOVO")
  origem       String  @default("SITE_PIZZATTOLOG")

  // Dados da pessoa
  nome     String
  email    String
  telefone String?
  cargo    String?

  // Dados da empresa
  empresa String?
  cnpj    String?

  // Solicitação de cotação
  solucao String?

  // Cadastro de agregados
  cidade       String?
  categoriaCnh String?
  possuiMopp   Boolean?
  possuiEar    Boolean?
  marcaVeiculo String?
  anoVeiculo   Int?

  // Conteúdo da solicitação
  assunto  String?
  mensagem String?

  // Consentimentos
  aceitePrivacidade  Boolean @default(false)
  aceiteComunicacoes Boolean @default(false)

  // Controle interno do CRM
  etapaCotacao      CotacaoSiteEtapa?
  leadId            String? @unique
  prospectId        String?
  clientId          String?
  lead              Lead? @relation("SolicitacaoSiteLead", fields: [leadId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  prospect          Prospect? @relation("SolicitacaoSiteProspect", fields: [prospectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  client            Client? @relation("SolicitacaoSiteClient", fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  responsavel       User? @relation("SolicitacaoSiteResponsavel", fields: [responsavelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  responsavelId     String?
  observacaoInterna String?

  // Datas
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  // Anexos
  anexos AnexoSolicitacaoSite[]

  @@index([etapaCotacao, responsavelId])
  @@index([prospectId])
  @@index([clientId])
  @@index([tipo])
  @@index([departamento])
  @@index([status])
  @@index([criadoEm])
}

