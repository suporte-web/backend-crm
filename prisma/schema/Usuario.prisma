model User {
  visitasResponsavel VisitaCliente[] @relation("VisitaResponsavel")
  visitasCriadas VisitaCliente[] @relation("VisitaCriador")
  visitasParticipante VisitaParticipante[] @relation("VisitaParticipanteUsuario")
  visitasRealizadas VisitaRealizacao[] @relation("VisitaRealizacaoUsuario")
  visitasValidadas VisitaValidacao[] @relation("VisitaValidacaoGestor")
  visitasReagendadas VisitaReagendamento[] @relation("VisitaReagendamentoUsuario")
  historicoVisitas VisitaHistorico[] @relation("VisitaHistoricoUsuario")
  anexosVisitas VisitaAnexo[] @relation("VisitaAnexoUsuario")
  leadAnexos LeadAnexo[]
  atendimentosSac AtendimentoSac[] @relation("SacAtendente")
  acoesSac AtendimentoSac[] @relation("SacAcao")
  conclusoesSac AtendimentoSac[] @relation("SacConclusao")
  historicoSac AtendimentoSacHistorico[] @relation("SacHistoricoUsuario")
  tarefasSac AtendimentoSacTarefa[] @relation("SacTarefaResponsavel")
  tarefasSacCriadas AtendimentoSacTarefa[] @relation("SacTarefaCriador")
  anexosSac AtendimentoSacAnexo[] @relation("SacAnexoUsuario")
  id                              String                  @id @default(uuid())
  name                            String
  email                           String                  @unique
  passwordHash                    String
  role                            UserRole                @default(CLIENTE)
  roles                           UserRole[]              @default([])
  createdAt                       DateTime                @default(now())
  updatedAt                       DateTime                @updatedAt
  isActive                        Boolean                 @default(true)
  mustChangePassword              Boolean                 @default(true)
  auditLogs                       AuditLog[]
  chatMessages                    ChatMessage[]           @relation("ChatMessageAuthor")
  privateChatMessages             ChatMessageRecipient[]
  chatParticipants                ChatParticipant[]
  clientProfile                   Client?                 @relation("ClientLoginUser")
  approvedClientDeletionRequests  ClientDeletionRequest[] @relation("ClientDeletionApprovedBy")
  requestedClientDeletionRequests ClientDeletionRequest[] @relation("ClientDeletionRequestedBy")
  uploadedClientDocuments         ClientDocument[]
  helpCenterArticlesCreated       HelpCenterArticle[]     @relation("HelpCenterArticleCreatedBy")
  helpCenterArticlesUpdated       HelpCenterArticle[]     @relation("HelpCenterArticleUpdatedBy")
  createdLeads                    Lead[]                  @relation("LeadCreatedBy")
  updatedLeads                    Lead[]                  @relation("LeadUpdatedBy")
  leadImportJobs                  LeadImportJob[]
  createdLeadTimelineEvents       LeadTimelineEvent[]     @relation("LeadTimelineEventAuthor")
  createdLeadObservations         LeadObservacao[]        @relation("LeadObservacaoAuthor")
  logsEmail                       LogEmail[]
  notifications                   Notification[]
  passwordResetTokens             PasswordResetToken[]
  authoredPosts                   PortalContent[]
  propostasCriadas                Proposta[]              @relation("PropostaCriadaPor")
  propostasEnviadas               Proposta[]              @relation("PropostaEnviadaPor")
  supplierInvites                 SupplierInvite[]        @relation("SupplierInviteAuthor")
  assignedTickets                 Ticket[]                @relation("TicketAssignedTo")
  requestedTickets                Ticket[]                @relation("TicketRequester")
  ticketHistoryEvents             TicketHistory[]         @relation("TicketHistoryActor")
  ticketMessages                  TicketMessage[]         @relation("TicketMessageAuthor")
  createdTimelineEvents           TimelineEvent[]         @relation("TimelineEventAuthor")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
