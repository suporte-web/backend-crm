DATABASE_URL=
JWT_SECRET=
JWT_ACCESS_SECRET=
FRONTEND_URL=
CORS_ORIGIN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

MARKETING_TOKEN_ENCRYPTION_KEY=

# Integração do informativo: mesmo segredo configurado no servidor Next.js do site.
SITE_LEAD_INTEGRATION_TOKEN=

# Origem do CRM para retorno do OAuth (não é a URL do site institucional).
MARKETING_FRONTEND_URL=http://localhost:3000
# GOOGLE_REDIRECT_URI local: http://localhost:3001/api/marketing-integrations/google/callback
# MARKETING_TOKEN_ENCRYPTION_KEY: 32 bytes aleatórios em base64; mantenha a chave estável.

# Endpoints públicos oficiais do Google; configurados somente no backend.
GOOGLE_OAUTH_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_OAUTH_REVOKE_URL=https://oauth2.googleapis.com/revoke
GOOGLE_ANALYTICS_ADMIN_API_URL=https://analyticsadmin.googleapis.com/v1beta
GOOGLE_ANALYTICS_DATA_API_URL=https://analyticsdata.googleapis.com/v1beta

# Rastreamento público: opcionais, somente no backend, se exigidos pela SSW.
SSW_TRACKING_PASSWORD=
SSW_TRACKING_COMPANY=

# Opcional: diretório PRIVADO dos anexos de Reclamações e Elogios (fora de uploads públicos).
# RELATOS_SITE_UPLOAD_DIR=

# Pasta privada para anexos dos Leads (padrão: private-uploads/lead-anexos)
# LEAD_ATTACHMENTS_UPLOAD_DIR=
